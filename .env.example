# Container do Google Tag Manager. Sem isso, o dataLayer ainda recebe
# lead_qualificado, mas nenhuma tag é disparada.
NEXT_PUBLIC_GTM_ID=

# Opcional. Recebe todo formulário enviado, qualificado ou não.
# O campo gtm_event vem como "lead_qualificado" ou null.
LEAD_WEBHOOK_URL=

# Opcional. Enviado como Authorization: Bearer, se o webhook exigir.
LEAD_WEBHOOK_SECRET=
